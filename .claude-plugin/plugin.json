{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "fema-mcp-server",
  "version": "0.3.0",
  "description": "Query FEMA disaster declarations, public assistance grants, housing aid, and NFIP flood insurance claims via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://github.com/cyanheads"
  },
  "homepage": "https://github.com/cyanheads/fema-mcp-server#readme",
  "repository": "git+https://github.com/cyanheads/fema-mcp-server.git",
  "license": "Apache-2.0",
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "fema",
    "disaster",
    "emergency-management",
    "nfip",
    "flood-insurance"
  ],
  "mcpServers": {
    "fema-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/fema-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio"
      }
    }
  }
}
